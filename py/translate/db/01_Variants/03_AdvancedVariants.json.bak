{
  "Overclocked (超频版)": {
    "Description": "通过采用高性能电脑的水冷技术，这款变体武器能够以超越以往的速度开火，以更高的复杂度为代价，带来无与伦比的射击速度。",
    "Explanation": "武器变体，射速提升且冷却能力增强，但人体工程学略有降低。",
    "ShortName": "OC",
    "Properties": {
      "CoolFactorGun": "+50%",
      "CoolFactorGunMods": 1,
      "SingleFireRate": "+35%",
      "BFirerate": "+35%",
      "Ergonomics": "-15",
      "Weight": "+20%"
    },
    "Weapons": [
      "AK-12",
      "AK-104",
      "AUG A1",
      "HK 416A5",
      "MCX .300 BLK",
      "SPEAR 6.8",
      "SA-58",
      "AS VAL",
      "MP7A2",
      "MPX",
      "P90",
      "PPSh-41",
      "Vector .45ACP",
      "PKM",
      "RPD",
      "RPDN",
      "UZI PRO Pistol"
    ],
    "Rarity": "Advanced"
  },
  "Upgraded (升级版)": {
    "Description": "我们对原件进行了清洁，拧紧了几颗螺丝，瞧——它现在正式‘升级’了！",
    "Explanation": "改进后坐力、精度、人机工程学、射速和热量积聚的武器变体",
    "ShortName": "Upgraded",
    "Properties": {
      "RecoilForceUp": "-15%",
      "RecoilForceBack": "-15%",
      "RecoilReturnSpeedHandRotation": "+7%",
      "RecoilCamera": "-15%",
      "RecoilDampingHandRotation": "-7%",
      "AimPlane": "-20%",
      "RecolDispersion": "-50%",
      "Ergonomics": "+15",
