  "Light Machine Gun (轻机枪)": {
    "Description": "我们很清楚，这本杂志要么尴尬地悬在武器下方，要么以某种方式卡在了里面——但我们就当这是个特色，继续往下看吧。",
    "Explanation": "7.62x54r弹药型号的武器变体，仅兼容100发弹匣。其特点包括后坐力增强、射速降低，并仅支持全自动射击模式。",
    "ShortName": "LMG",
    "Properties": {
      "RecoilForceBack": "+35%",
      "RecoilForceUp": "+35%",
      "RecoilCamera": "+35%",
      "RecoilStableIndexShot": 100,
      "RecoilStableAngleIncreaseStep": "+35%",
      "RecoilDampingHandRotation": "+5%",
      "RecoilReturnSpeedHandRotation": "+35%",
      "Ergonomics": "+10",
      "BFirerate": "-35%",
      "WeapFireType": [
        "fullauto"
      ],
      "DurabilityBurnRatio": "-50%"
    },
    "Changes": {
      "Minimum": {
        "BFirerate": 450
      },
      "Slots": {
        "mod_magazine": {
          "FromWeapons": [
            "PKP"
          ]
        }
      },
      "Chambers": {
        "FromWeapons": [
          "PKP"
        ]
      }
    },
    "IndividualChanges": {
      "Blicky": {
        "Slots": {
          "mod_magazine": {
            "Filter": [
              "Blicky Special Magical Unbelievable Magazine"
            ]
          }
        }
      }
    },
    "Weapons": [
      "HK 416A5",
      "M4A1",
      "SA-58",
      "RD-704",
      "AKM",
      "AK-12",
      "MCX .300 BLK",
      "VPO-136 Vepr-KM",
      "RPK-16",
      "Blicky"
    ],
    "Rarity": "Advanced"
  },
  "Shotgun (霰弹枪)": {
    "Description": "用来给朋友们惊喜的完美武器。他们会以为你带了把突击步枪——直到看见弹匣。这时他们才明白你在搞什么名堂。",
    "Explanation": "12/70霰弹口径的武器变体，兼容Saiga-12K弹匣，但后坐力增大且射速较低。",
    "ShortName": "Shotgun",
    "Properties": {
      "RecoilForceUp": "+45%",
      "RecoilForceBack": "+90%",
      "BFirerate": "-34%",
      "RecoilCamera": "+30%",
      "ShotgunDispersion": 3
    },
    "Changes": {
      "Minimum": {
        "BFirerate": 450
      },
      "Slots": {
        "mod_magazine": {
          "FromWeapons": [
            "Saiga-12K",
            "AA-12 Gen 1"
          ],
          "Add": [
            "Shotgun Variant 35-round drum magazine"
          ]
        }
      },
      "Chambers": {
        "FromWeapons": [
          "Saiga-12K"
        ]
      }
    },
    "Weapons": [
      "HK 416A5",
      "MCX .300 BLK",
      "SPEAR 6.8",
      "SA-58",
      "AS VAL",
      "UMP 45",
      "MP7A2",
      "FN 5-7",
      "STM-9",
      "VPO-101 Vepr-Hunter",
      "AKS-74",
      "RPDN",
      "RPD",
      "Velociraptor .300 BLK"
    ],
    "Rarity": "Advanced"
  },
  "Unbreakable (牢不可破)": {
    "Description": "某位电视名人用他的神奇产品让这把枪变得坚不可摧  \n现在你可以把它扔进沙子里，再也不用担心卡壳  \n~甚至能在水下使用！~  \n只是……最好别把它切成两半",
    "Explanation": "武器变体免疫耐久度损伤、过热及故障。",
    "ShortName": "Unbreakable",
    "Properties": {
      "DurabilityBurnRatio": 0,
      "HeatFactorByShot": 0,
      "AllowJam": false,
      "AllowFeed": false,
      "AllowMisfire": false,
      "AllowSlide": false
    },
    "Weapons": [
      "AS VAL",
      "VSS Vintorez",
      "AVT-40",
      "M4A1",
      "PKP",
      "MP5",
      "VPO-101 Vepr-Hunter"
    ],
    "Rarity": "Advanced"
  },
  "Hypersonic (高超声速)": {
    "Description": "用于改造这件武器的技术，理论上根本不该成立。数十年的研究仅勉强降低了子弹对重力的敏感度，且远未达到完善。",
    "Explanation": "武器变体，拥有极高的初速和极佳的精度",
    "ShortName": "Hypersonic",
    "Properties": {
      "Velocity": 350,
      "CenterOfImpact": 0.01
    },
    "Weapons": [
      "Mk-18 Mjölnir",
      "ASh-12",
      "RD-704",
      "G28",
