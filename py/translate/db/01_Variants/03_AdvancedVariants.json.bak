      "RSh-12",
      "AK-12",
      "AK-105",
      "MCX .300 BLK",
      "Mk 17",
      "G36"
    ],
    "Rarity": "Advanced"
  },
  "Sniper (狙击手)": {
    "Description": "一款专为偶尔在舒适安全距离内将人类误认为野猪的猎人设计的武器",
    "Explanation": "霰弹枪武器变体，提升射速与精准度",
    "ShortName": "Sniper",
    "Properties": {
      "Velocity": 100,
      "ShotgunDispersion": 1,
      "CenterOfImpact": 0.01
