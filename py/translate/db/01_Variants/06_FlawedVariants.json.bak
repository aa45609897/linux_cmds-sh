{
  "Panic (恐慌)": {
    "Description": "别慌——只是只蟑螂…… *砰* *砰* *砰*",
    "Explanation": "霰弹枪限制使用MaxRounds Powermag 20发弹匣，具备全自动射击模式，后坐力增大，射速更高。",
    "ShortName": "Panic",
    "Properties": {
      "BFirerate": "+20%",
      "WeapFireType": [
        "fullauto"
      ],
      "RecoilForceBack": "+59%",
      "RecoilForceUp": "+59%",
      "RecoilCamera": "+50%",
      "AllowJam": false
    },
    "Changes": {
      "Minimum": {
        "BFirerate": 250
      },
      "Slots": {
        "mod_magazine": {
          "BasedOn": {
            "Property": "ReloadMode",
            "Cases": {
              "ExternalMagazine": {
                "Filter": [
                  "5cf8f3b0d7f00c00217872ef"
                ]
              },
              "InternalMagazine": {
                "Filter": [
                  "SOK-12 12ga MD Arms Internal 20-round magazine"
                ]
              }
            }
          }
        }
      },
      "Chambers": {
        "FromWeapons": [
          "Saiga-12K"
        ]
      }
    },
    "IndividualChanges": {
      "M3 Super 90": {
        "Properties": {
          "WeapFireType": [
            "semiauto",
            "single"
          ]
        }
      },
      "Blicky": {
        "Slots": {
          "mod_magazine": {
            "Filter": [
              "Blicky Special Magical Unbelievable Magazine"
            ]
          }
        }
      }
    },
    "Weapons": [
      "KS-23M",
      "M3 Super 90",
      "590A1",
      "M870",
      "MP-133",
      "MP-153",
      "MP-155",
      "TOZ-106",
      "AA-12 Gen 1",
      "Blicky"
    ],
    "Rarity": "Flawed"
  },
  "Control-Fire (控制火势)": {
    "Description": "专为渴望体验传奇“全自动”射击模式的新晋PMC设计的训练武器。可惜，他们最终只会大失所望。",
    "Explanation": "仅具备全自动射击模式的武器变体，因低射速与无后坐力特性而具备更优操控性。",
    "ShortName": "Control",
    "Properties": {
      "BFirerate": 80,
      "WeapFireType": [
        "fullauto"
      ],
      "RecoilStableIndexShot": 0,
      "RecoilForceBack": "+100%"
