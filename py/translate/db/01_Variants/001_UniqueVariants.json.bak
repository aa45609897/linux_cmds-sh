{
  "PKM Unique (PKM独特)": {
    "Description": "有人真的很想拥有一把便携式12.7×108毫米口径轻机枪。但问题是，我们不能让随便什么人都掌握这种力量，所以我们把这件武器做成了一种折中的好选择。",
    "Explanation": "PKM >重型氪金枪<\n这款独特变体融合了重型机枪变体的最佳特性——降低后坐力与提升射速——以及氪金变体的.50 BMG口径。更不必说，我们还为其配备了100发容量的.50 BMG弹匣！",
    "ShortName": ">Heavy P2W Gun<",
    "Properties": {
      "RecoilForceBack": "+150%",
      "RecoilForceUp": "-60%",
      "WeapFireType": [
        "fullauto"
      ],
      "BFirerate": "+20%",
      "RecoilCamera": "+15%"
    },
    "Changes": {
      "Slots": {
        "mod_magazine": {
          "Filter": [
            "PK .50 BMG 100-round box",
            "Pay to Win Variant 5-round magazine",
            "Pay to Win Variant 20-round magazine",
            "Pay to Win Variant 30-round magazine",
            "Pay to Win Variant 50-round magazine"
          ]
        }
      },
      "Chambers": {
        "FromWeapons": [
          "AK-50"
        ]
      }
    },
    "Weapons": [
      "PKM"
    ],
    "Rarity": "Unique"
  },
  "AK-74 Unique (AK-74独特版)": {
    "Description": "当你不用全自动模式射击这把武器时，卡拉什尼科夫会在坟墓里翻身，产生的能量足以供应一座中型城市。",
    "Explanation": "AK-74 >超频元变体<  \n这款独特变体融合了超频变体的最佳特性——射速与枪械冷却能力——以及元变体的属性参数。",
    "ShortName": ">Overclocked Meta<",
    "Properties": {
      "RecoilForceUp": "-25%",
      "RecoilForceBack": "-10%",
      "RecoilReturnSpeedHandRotation": "+10%",
      "RecoilCamera": "-10%",
